{
  "manifest_version": 3,
  "name": "Mail Tarihçe Günlüğü",
  "version": "1.1.0",
  "description": "Gelen maillerin adlarını (konu/gönderen), geliş tarihlerini ve silinme tarihlerini kaydeder; kendi tam arayüzü ve hızlı açılır penceresi ile arayıp geri yüklemenizi sağlar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mail-tarihce-gunlugu@local.extension",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "src/store.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "Mail Tarihçe Günlüğü",
    "default_icon": "icons/icon.svg",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  }
}
