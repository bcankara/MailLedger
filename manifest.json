{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailledger@bcankara.github.io",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "src/i18n.js",
      "src/store.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": "icons/icon.svg",
    "default_popup": "ui/popup.html"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  }
}
